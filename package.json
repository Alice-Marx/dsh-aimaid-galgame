{
  "name": "@ljwei-stak/dsh-galgame",
  "version": "0.1.0",
  "type": "module",
  "description": "Independent DeepSeek Harness visual novel: Echo City and Old City Migration, story saves, portrait/audio settings and model-powered free dialogue.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alice-Marx/deepseek-harness-galgame.git"
  },
  "homepage": "https://github.com/Alice-Marx/deepseek-harness-galgame#readme",
  "bugs": {
    "url": "https://github.com/Alice-Marx/deepseek-harness-galgame/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./.dsh-plugin/index.mjs",
  "exports": {
    ".": "./.dsh-plugin/index.mjs",
    "./client": "./.dsh-plugin/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    ".dsh-plugin/index.mjs",
    ".dsh-plugin/gal-remote-service.mjs",
    ".dsh-plugin/shared/gal-remote.mjs",
    ".dsh-plugin/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "INSTALLATION_GUIDE.zh.md",
    "MIGRATION.md",
    "LICENSE",
    "docs/ECHO_CITY_STORY.zh.md",
    "docs/GAL_SETTINGS.zh.md",
    "docs/GAL_ART_SOURCES.zh.md",
    "docs/GAL_ART_PROMPTS.zh.md",
    "docs/assets/gal-portrait-sources.json"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "prepack": "node scripts/prepack.mjs",
    "pack:local": "npm pack --pack-destination dist"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-group": "1.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/cordis-plugin-timer": "1.1.6",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-file-upload": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
